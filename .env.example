# Environment Variables for Supabase
# 
# Create a Supabase project at https://supabase.com
# Then copy your credentials from Project Settings > API
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env to git!

# Your Supabase project URL
# Example: https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_url_here

# Your Supabase anonymous/public API key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OPTIONAL: If you need the service role key for admin operations (NEVER expose in frontend!)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
